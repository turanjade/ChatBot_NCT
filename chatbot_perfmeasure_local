def _build_compare_db():
    """
    Merge DB slot A and B into a temporary in-memory SQLite database.
    Tables from slot A are attached as <name>_a, slot B as <name>_b.
    Returns (merged_conn, merged_schema) or raises if either slot is empty.
    """
    conn_a = DB["A"]["conn"]
    conn_b = DB["B"]["conn"]
    if conn_a is None or conn_b is None:
        raise ValueError("Both scenario A and B must be loaded before comparing.")

    merged = sqlite3.connect(":memory:", check_same_thread=False)

    def _copy_tables(src, suffix):
        cur = src.cursor()
        cur.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
        for (tname,) in cur.fetchall():
            df = pd.read_sql(f"SELECT * FROM {tname}", src)
            df.to_sql(f"{tname}_{suffix}", merged, if_exists="replace", index=False)

    _copy_tables(conn_a, "a")
    _copy_tables(conn_b, "b")
    merged.commit()

    schema = get_schema(merged)
    folder_a = DB["A"]["folder"] or "Scenario A"
    folder_b = DB["B"]["folder"] or "Scenario B"
    header = (
        f"COMPARISON MODE — two scenarios loaded:\n"
        "  Scenario A → tables suffixed _a  (e.g. county_demographics_a)\n"
        "  Scenario B → tables suffixed _b  (e.g. county_demographics_b)\n"
        f"To compare, JOIN on the geography key or use subqueries / UNION ALL.\n"
        f"Example: SELECT a.COUNTY, a.EMP as emp_a, b.EMP as emp_b, (b.EMP - a.EMP) as delta\n"
        f"         FROM county_demographics_a a JOIN county_demographics_b b USING(COUNTY)\n\n"
    )
    return merged, header + schema, folder_a, folder_b


def _compare_summarize(question, sql, df, folder_a, folder_b):
    local = f"Scenario A: {folder_a}; Scenario B: {folder_b}. " + _local_result_summary(df)
    if not LLM_SEND_RESULTS or df.empty:
        return local
    return _llm_summary(
        f"Comparing Scenario A = {folder_a} and Scenario B = {folder_b}.\n"
        f"User asked: {question}\nSQL: {sql}\nResult:\n{_result_text(df, question)}\n"
        "Summarize key differences in 3-5 sentences; include absolute and percent "
        "changes where applicable and specific numbers. " + SUMMARY_STYLE,
        700, local)


