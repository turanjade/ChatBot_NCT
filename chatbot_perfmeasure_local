def open_browser():
    webbrowser.open("http://127.0.0.1:5050")


def _port_in_use(host, port):
    # On Windows the dev server binds with SO_REUSEADDR, so a second copy starts without
    # error and the browser's requests land on either copy (old code or new, at random).
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(1)
        return s.connect_ex((host, port)) == 0


if __name__ == "__main__":
    if _port_in_use("127.0.0.1", 5050):
        msg = ("Port 5050 is already in use, most likely by another copy of this server "
               "(copies started with pythonw.exe have no window; end them in Task Manager). "
               "Stop it first so the browser doesn't reach the old code.")
        if sys.stderr is None:                  # pythonw.exe: no console to print to
            import ctypes
            ctypes.windll.user32.MessageBoxW(0, msg, "NCT chatbot server", 0x10)
        sys.exit(msg)
    if os.environ.get("WERKZEUG_RUN_MAIN") != "true":
        Timer(1.5, open_browser).start()
    app.run(host="127.0.0.1", port=5050, debug=False, threaded=True,
            extra_files=[], exclude_patterns=["*.venv*", "*site-packages*"])
