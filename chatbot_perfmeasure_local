def llm_chat(system_prompt, user_prompt, max_tokens=1024):
    if not LLM_BASE_URL or not LLM_API_KEY:
        raise RuntimeError("Set LLM_BASE_URL (ending in /v1) and LLM_API_KEY before asking questions")
    if not LLM_BASE_URL.endswith("/v1"):
        raise RuntimeError("LLM_BASE_URL must end in /v1")
    if not (LLM_BASE_URL.startswith("https://") or
            LLM_BASE_URL.startswith("http://127.0.0.1:") or
            LLM_BASE_URL.startswith("http://localhost:")):
        raise RuntimeError("Use HTTPS for remote LLM_BASE_URL (or an authenticated local tunnel)")
    payload = {
        "model": MODEL,
        "max_tokens": max_tokens,
        "temperature": 0.2,
        "messages": [{"role": "system", "content": system_prompt},
                     {"role": "user", "content": user_prompt}],
        "chat_template_kwargs": {"enable_thinking": False},
    }
    req = urlrequest.Request(
        f"{LLM_BASE_URL}/chat/completions",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Authorization": f"Bearer {LLM_API_KEY}",
                 "Content-Type": "application/json"},
        method="POST",
    )
    with urlrequest.urlopen(req, timeout=300) as response:
        reply = json.load(response)
    content = reply["choices"][0]["message"].get("content")
    if not content or not content.strip():
        raise RuntimeError("LLM returned empty content; check thinking settings and token limit")
    return content.strip()


